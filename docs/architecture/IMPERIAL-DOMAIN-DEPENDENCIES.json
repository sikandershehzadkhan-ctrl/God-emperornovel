{
  "schemaVersion": 1,
  "direction": "Experience -> Application -> Domain contracts -> Platform kernel -> Persistence adapters -> Infrastructure. Runtime dependency edges must follow declared direction.",
  "domains": {
    "platform-kernel": {
      "layer": 3,
      "dependsOn": [
        "platform-data",
        "delivery-platform"
      ]
    },
    "identity": {
      "layer": 5,
      "dependsOn": [
        "platform-kernel",
        "platform-data"
      ]
    },
    "catalog": {
      "layer": 7,
      "dependsOn": [
        "platform-kernel",
        "platform-data",
        "rights"
      ]
    },
    "publishing": {
      "layer": 8,
      "dependsOn": [
        "platform-kernel",
        "platform-data",
        "identity",
        "rights",
        "media"
      ]
    },
    "reader": {
      "layer": 9,
      "dependsOn": [
        "platform-kernel",
        "platform-data",
        "identity",
        "catalog",
        "publishing"
      ]
    },
    "community": {
      "layer": 7,
      "dependsOn": [
        "platform-kernel",
        "platform-data",
        "identity",
        "rights"
      ]
    },
    "creator": {
      "layer": 9,
      "dependsOn": [
        "platform-kernel",
        "platform-data",
        "identity",
        "publishing",
        "rights"
      ]
    },
    "rights": {
      "layer": 6,
      "dependsOn": [
        "platform-kernel",
        "platform-data",
        "identity"
      ]
    },
    "payments": {
      "layer": 9,
      "dependsOn": [
        "platform-kernel",
        "platform-data",
        "identity",
        "publishing"
      ]
    },
    "discovery": {
      "layer": 10,
      "dependsOn": [
        "platform-kernel",
        "platform-data",
        "catalog",
        "publishing",
        "reader",
        "rights"
      ]
    },
    "media": {
      "layer": 7,
      "dependsOn": [
        "platform-kernel",
        "platform-data",
        "rights"
      ]
    },
    "ai": {
      "layer": 7,
      "dependsOn": [
        "platform-kernel",
        "platform-data",
        "identity",
        "rights"
      ]
    },
    "administration": {
      "layer": 10,
      "dependsOn": [
        "platform-kernel",
        "platform-data",
        "identity",
        "rights",
        "payments"
      ]
    },
    "experience-shell": {
      "layer": 11,
      "dependsOn": [
        "identity",
        "catalog",
        "publishing",
        "reader",
        "community",
        "creator",
        "discovery",
        "media",
        "ai",
        "administration"
      ]
    },
    "platform-data": {
      "layer": 4,
      "dependsOn": [
        "delivery-platform"
      ]
    },
    "platform-quality": {
      "layer": 0,
      "dependsOn": []
    },
    "platform-architecture": {
      "layer": 0,
      "dependsOn": []
    },
    "delivery-platform": {
      "layer": 5,
      "dependsOn": []
    },
    "repository-operations": {
      "layer": 0,
      "dependsOn": [
        "platform-quality",
        "delivery-platform"
      ]
    }
  },
  "rules": {
    "dependenciesMustExist": true,
    "noCycles": true,
    "featureDomainsCannotDependOnExperienceShell": true,
    "contractsRequiredForCrossDomainWrites": true
  }
}
